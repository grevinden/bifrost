{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "enable_logging": false,
    "initial_pool_size": 10
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "./test-bifrost-config.db"
    }
  },
  "logs_store": {
    "enabled": true
  },
  "providers": {
    "lm-studio": {
      "keys": [
        {
          "name": "test",
          "weight": 1
        }
      ],
      "proxy_config": {
        "type": "http",
        "url": "http://127.0.0.1:3128"
      },
      "custom_provider_config": {
        "allowed_requests": {
          "list_models": true,
          "chat_completion": true,
          "chat_completion_stream": true
        },
        "base_provider_type": "openai",
        "is_key_less": true
      }
    }
  },
  "plugins": [
    {
      "enabled": true,
      "name": "llmboster",
      "config": {
        "prompt": "Think step by step, write down your reasoning, then give a final answer."
      }
    }
  ]
}
